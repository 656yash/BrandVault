  },
  "keywords": [
    "brand-governance",
    "brand-safety",
    "content-moderation",
    "cloudflare-workers",
    "groq-ai",
    "brandvault"
  ],
  "author": "BrandVault Team",
  "license": "MIT",
  "dependencies": {
    "firebase": "^13.3.0"
  }
}
