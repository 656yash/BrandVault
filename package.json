{
  "name": "brandvault",
  "version": "1.0.0",
  "private": true,
  "description": "BrandVault - Intelligent Brand Governance & Compliance Platform",
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:worker": "npm run dev --workspace=workers/api",
    "build": "npm run build --workspaces",
